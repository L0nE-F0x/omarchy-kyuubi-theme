# Kyuubi btop — semantic thermal meters: ash means idle, ember means load.
#
# Low/free capacity sits quietly in warm obsidian ash; active load rises from
# smoldering crimson-umber through Kurama chakra orange into molten ember gold.
# Upload uses moonlit mist steel so bidirectional traffic stays readable apart.
# Temperature reserves cool sage -> gold -> bijuu crimson as a genuine warning ramp.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#160C0B"

# Main text color
theme[main_fg]="#FCE6C8"

# Title color for boxes
theme[title]="#FFF4E4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#F26B1D"

# Background color of selected item in processes box
theme[selected_bg]="#521D15"

# Foreground color of selected item in processes box
theme[selected_fg]="#FFD46B"

# Color of inactive/disabled text
theme[inactive_fg]="#A37B64"

# Color of text appearing on top of graphs
theme[graph_text]="#E3C19E"

# Background color of the percentage meters
theme[meter_bg]="#261411"

# Misc colors for processes box
theme[proc_misc]="#BE9779"

# Box outlines — cohesive ember hierarchy without rainbow clutter
theme[cpu_box]="#F26B1D"
theme[mem_box]="#F0B429"
theme[net_box]="#F04A58"
theme[proc_box]="#CA7642"

# Box divider line and small boxes line color
theme[div_line]="#5E3528"

# Temperature graph color: cool sage -> ember gold -> bijuu crimson danger
theme[temp_start]="#92B46E"
theme[temp_mid]="#F0B429"
theme[temp_end]="#F04A58"

# CPU graph colors: smoldering umber -> Kurama orange -> molten gold
theme[cpu_start]="#9E2A2B"
theme[cpu_mid]="#F26B1D"
theme[cpu_end]="#FFD46B"

# Mem/Disk free meter — at rest, recedes into warm ash
theme[free_start]="#4E382E"
theme[free_mid]="#785848"
theme[free_end]="#A37B64"

# Mem/Disk cached meter — warm bronze reserve
theme[cached_start]="#6B3A22"
theme[cached_mid]="#A65E34"
theme[cached_end]="#E08B3C"

# Mem/Disk available meter — muted ash
theme[available_start]="#4E382E"
theme[available_mid]="#785848"
theme[available_end]="#A37B64"

# Mem/Disk used meter — active memory load heats up
theme[used_start]="#9E2A2B"
theme[used_mid]="#F26B1D"
theme[used_end]="#FFD46B"

# Download graph colors — inbound bursts burn orange to gold
theme[download_start]="#9E2A2B"
theme[download_mid]="#F26B1D"
theme[download_end]="#FFD46B"

# Upload graph colors — cool moonlit mist steel for crisp up/down separation
theme[upload_start]="#4D6673"
theme[upload_mid]="#78AEBB"
theme[upload_end]="#A4CCD4"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#9E2A2B"
theme[process_mid]="#F26B1D"
theme[process_end]="#FFD46B"

# Monotonic luminance ramp for filled graphs: seal-black -> crimson -> orange -> bright gold
theme[gradient_color_0]="#160C0B"
theme[gradient_color_1]="#2F1311"
theme[gradient_color_2]="#5E1D1B"
theme[gradient_color_3]="#9E2A2B"
theme[gradient_color_4]="#D94D1E"
theme[gradient_color_5]="#F27A22"
theme[gradient_color_6]="#F5B83D"
theme[gradient_color_7]="#FFE084"
