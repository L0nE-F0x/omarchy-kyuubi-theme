{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/omarchy/branding/about.txt",
    "color": { "1": "#F26B1D", "2": "#C41E3A", "3": "#F0B429" },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "#F26B1D"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "#F26B1D"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "#F26B1D"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "#F26B1D"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "#F26B1D"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "#F26B1D"
    },
    {
      "type": "swap",
      "key": "└ └󰓡",
      "keyColor": "#F26B1D"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\ue900 OS",
      "keyColor": "#C41E3A",
      "text": "version=$(omarchy-version) && echo \"Omarchy $version\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "#C41E3A",
      "text": "omarchy-version-branch"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#C41E3A"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "#C41E3A"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "#C41E3A"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "#C41E3A"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "#C41E3A"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────Age / Uptime / Update─────────────┐"
    },
    {
      "type": "command",
      "key": "│ ├󰔚",
      "keyColor": "#F0B429",
      "text": "omarchy-show-logo >/dev/null; echo"
    },
    {
      "type": "uptime",
      "key": "│ ├󰔟",
      "keyColor": "#F0B429"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    }
  ]
}
